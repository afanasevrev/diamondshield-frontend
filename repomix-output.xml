.ds-toast-container {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 2000;
  display: grid;
  gap: 12px;
  width: min(420px, calc(100vw - 40px));
}

.ds-toast {
  position: relative;
  padding: 14px 42px 14px 14px;
  border-radius: 16px;
  border: 1px solid var(--ds-border);
  background: rgba(5, 14, 26, 0.96);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.38);
}

.ds-toast-success {
  border-color: rgba(34, 197, 94, 0.55);
}

.ds-toast-warning {
  border-color: rgba(245, 158, 11, 0.65);
}

.ds-toast-danger {
  border-color: rgba(239, 68, 68, 0.65);
}

.ds-toast-info {
  border-color: rgba(55, 183, 255, 0.65);
}

.ds-toast-title {
  color: var(--ds-text);
