export type RealtimeEventType =
  | 'access-event'
  | 'alarm-event'
  | 'device-status'
  | 'local-server-status'
  | 'guest-event'
  | 'perco-event'
  | 'heartbeat'
  | 'unknown';

export interface RealtimeEnvelope<TPayload = unknown> {
  id: string;
  type: RealtimeEventType;
  receivedAt: string;
  payload: TPayload;
}

export interface RealtimeAccessEvent {
  id?: string;
  eventTime?: string;
